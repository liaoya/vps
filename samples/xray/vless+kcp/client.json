{
  "inbounds": [
    {
      "listen": "0.0.0.0",
      "port": "1080",
      "protocol": "http"
    },
    {
      "listen": "0.0.0.0",
      "port": 1081,
      "protocol": "socks",
      "settings": {
        "udp": true
      }
    }
  ],
  "log": {
    "loglevel": "warning"
  },
  "outbounds": [
    {
      "protocol": "freedom",
      "tag": "direct"
    },
    {
      "protocol": "blackhole",
      "tag": "block"
    },
    {
      "protocol": "vless",
      "settings": {
        "vnext": [
          {
            "address": "<ip>",
            "port": 28672,
            "users": [
              {
                "encryption": "none",
                "id": "48b35c3b-a29e-414c-8d5b-c9fb53473120"
              }
            ]
          }
        ]
      },
      "streamSettings": {
        "kcpSettings": {
          "congestion": false,
          "downlinkCapacity": 200,
          "header": {
            "type": "dtls"
          },
          "mtu": 1350,
          "readBufferSize": 5,
          "seed": "qwertyuiop",
          "tti": 30,
          "uplinkCapacity": 50,
          "writeBufferSize": 5
        },
        "network": "kcp"
      },
      "tag": "proxy"
    }
  ],
  "routing": {
    "domainStrategy": "IPOnDemand",
    "rules": [
      {
        "domain": [
          "geosite:category-ads-all"
        ],
        "outboundTag": "block",
        "type": "field"
      },
      {
        "domain": [
          "geosite:geolocation-cn"
        ],
        "outboundTag": "direct",
        "type": "field"
      },
      {
        "ip": [
          "geoip:private",
          "geoip:cn"
        ],
        "outboundTag": "direct",
        "type": "field"
      },
      {
        "domain": [
          "geosite:geolocation-!cn"
        ],
        "outboundTag": "proxy",
        "type": "field"
      },
      {
        "ip": [
          "geoip:!cn"
        ],
        "outboundTag": "proxy",
        "type": "field"
      }
    ]
  }
}
